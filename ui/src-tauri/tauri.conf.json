{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheHarness",
  "version": "0.1.0",
  "identifier": "tech.aldo.theharness",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "TheHarness", "width": 1440, "height": 920, "minWidth": 960, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
